{
  "name": "department-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && node scripts/check-runtime.mjs",
    "start": "node dist/main.js",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:docker": "npm run build && node test/docker-env.mjs",
    "test:agent": "npm run build && node test/review-dev-docker.mjs",
    "test:external:docker": "node test/external-docker.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "yaml": "2.8.1",
    "jose": "^6.2.13"
  }
}
