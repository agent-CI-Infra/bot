{
  "name": "launchpad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build --workspace=bot-public-dashboard",
    "check": "tsc -p tsconfig.json --noEmit && node scripts/check-runtime.mjs",
    "start": "node dist/main.js",
    "test": "npm run build && node test/framework/test-sets.mjs",
    "test:e2e": "npm run build && playwright test -c test/e2e/playwright.config.mjs",
    "test:docker": "npm run build && node test/docker/projects/docker-env.mjs",
    "test:commands:docker": "node test/docker/runner/command-lifecycle-docker.mjs",
    "test:review-session": "npm run build && node --test test/live/review/review-session-runner.mjs",
    "test:agent": "npm run build && node test/docker/agent/review-dev-docker.mjs",
    "test:external:docker": "node test/docker/external/external-docker.mjs",
    "test:pi:docker": "npm run build && node test/docker/agent/pi-controller-docker.mjs",
    "test:assistant:docker": "node test/docker/manager/assistant-computers-docker.mjs",
    "test:deploy:docker": "node test/docker/deploy/deploy-recovery-docker.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "2.1.319",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.76.0",
    "@mermaid-js/tiny": "12.3.0",
    "dompurify": "3.4.17",
    "jose": "^6.2.13",
    "marked": "18.2.0",
    "yaml": "2.9.0"
  },
  "workspaces": [
    "public-board/dashboard"
  ]
}
