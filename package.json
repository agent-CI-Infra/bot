{
  "name": "department-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build --workspace=bot-public-dashboard",
    "check": "tsc -p tsconfig.json --noEmit && node scripts/check-runtime.mjs",
    "start": "node dist/main.js",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:docker": "npm run build && node test/docker-env.mjs",
    "test:review-session": "npm run build && node --test test/review-session-runner.mjs",
    "test:agent": "npm run build && node test/review-dev-docker.mjs",
    "test:external:docker": "node test/external-docker.mjs",
    "test:pi:docker": "npm run build && node test/pi-controller-docker.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.1.0",
    "@larksuiteoapi/node-sdk": "^1.76.0",
    "jose": "^6.2.13",
    "yaml": "2.9.0"
  },
  "workspaces": [
    "public-board/dashboard"
  ]
}
